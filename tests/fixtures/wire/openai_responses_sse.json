            "reasoning_tokens": 0
          }
        }
      }
    }
  ],
  "expected": {
    "model_name": "gpt-5",
    "input_tokens": 25,
    "output_tokens": 8,
    "cache_read_tokens": 0,
    "cache_convention": "inclusive"
  },
